local function addBtn(name, key)
    local b = Instance.new("TextButton", Container)
    b.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    b.Text = name .. ": OFF"
    b.TextColor3 = Color3.fromRGB(255, 50, 50)
    b.Font = Enum.Font.SourceSansSemibold
    b.TextSize = 11
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)

    b.MouseButton1Click:Connect(function()
        getgenv().Capri[key] = not getgenv().Capri[key]
        local state = getgenv().Capri[key]
        b.Text = name .. (state and ": ON" or ": OFF")
        b.TextColor3 = state and Color3.fromRGB(50, 255, 50) or Color3.fromRGB(255, 50, 50)
        b.BackgroundColor3 = state and Color3.fromRGB(20, 60, 20) or Color3.fromRGB(45, 45, 55)
    end)
end

