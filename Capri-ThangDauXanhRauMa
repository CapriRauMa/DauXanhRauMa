    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        holdingJump = true
        task.spawn(function()
            while holdingJump do
                doJump()
                task.wait(repeatSpeed)
            end
        end)
    end
end)

JumpBtn.InputEnded:Connect(function(input)
