-- Silent Aim Hook (Hỗ trợ Silent Aim cho cả Player và NPC nằm trong FOV)
local old
old = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    local C = getgenv().Capri
    if not checkcaller() and (method == "FireServer" or method == "InvokeServer") and C.CurrentTarget then
        local pred = C.CurrentTarget.Position + (C.CurrentTarget.Velocity * C.PredictionStrength)
        for i, v in pairs(args) do
            if typeof(v) == "Vector3" then 
                args[i] = pred
            elseif typeof(v) == "CFrame" then 
                args[i] = CFrame.new(v.Position, pred) 
            end
        end
    end
    return old(self, unpack(args))
end)

