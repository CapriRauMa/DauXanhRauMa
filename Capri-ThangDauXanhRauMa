--// Target Selector Engine (Chỉ aim mục tiêu nằm TRONG vòng tròn FOV)
task.spawn(function()
    while task.wait(0.1) do
        local C = getgenv().Capri
        local currentFOV = C.SuperZone_Active and 500 or 250
        C.FOV = currentFOV
        
        local best, shortest = nil, C.FOV 
        local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        
        if root then
            local potential = {}
            for _, p in pairs(Players:GetPlayers()) do 
                if p ~= LocalPlayer and p.Character then 
                    table.insert(potential, p.Character) 
                end 
            end
            
            if workspace:FindFirstChild("Enemies") then 
                for _, e in pairs(workspace.Enemies:GetChildren()) do 
                    table.insert(potential, e) 
                end 
            end
            
            for _, obj in pairs(workspace:GetChildren()) do
                if obj:IsA("Model") and obj ~= LocalPlayer.Character then
                    local hum = obj:FindFirstChildOfClass("Humanoid")
                    local hrp = obj:FindFirstChild("HumanoidRootPart")
                    if hum and hrp and not Players:GetPlayerFromCharacter(obj) then
                        table.insert(potential, obj)
                    end
                end
            end
            
            local circleCenter = Vector2.new(
                (C.ShowZone and customPosX) or (Camera.ViewportSize.X / 2),
                (C.ShowZone and customPosY) or (Camera.ViewportSize.Y / 2)
            )
            
            for _, char in pairs(potential) do
                local hPart = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChild("Humanoid")
                if hPart and hum and hum.Health > 0 then
                    local mag = (hPart.Position - root.Position).Magnitude
                    if mag < C.MaxDist then
                        local isNPC = not Players:GetPlayerFromCharacter(char)
                        if (isNPC and C.SilentAim_NPC) or (not isNPC and (C.SilentAim_Player or C.CamLock_Player)) then
                            -- Kiểm tra xem mục tiêu có nằm TRONG vòng tròn FOV không
                            local screenPos, onScreen = Camera:WorldToViewportPoint(hPart.Position)
                            if onScreen then
                                local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - circleCenter).Magnitude
                                if screenDist <= C.FOV and screenDist < shortest then
                                    shortest = screenDist
                                    best = hPart
                                end
                            end
                        end
                    end
                end
            end
            C.CurrentTarget = best
        end
    end
end)

