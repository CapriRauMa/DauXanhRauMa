local function applySavedButtonPositions(data)
    if type(data) ~= "table" then return end
    if type(data.CamBtnPos) == "table" then CamBtn.Position = UDim2.new(unpack(data.CamBtnPos)) end
    if type(data.AimBtnPos) == "table" then AimBtn.Position = UDim2.new(unpack(data.AimBtnPos)) end
    if type(data.JumpBtnPos) == "table" then JumpBtn.Position = UDim2.new(unpack(data.JumpBtnPos)) end
    if type(data.V4BtnPos) == "table" then V4Btn.Position = UDim2.new(unpack(data.V4BtnPos)) end
    if type(data.DashBtnPos) == "table" then DashBtn.Position = UDim2.new(unpack(data.DashBtnPos)) end
    if type(data.ZoneBtnPos) == "table" then ZoneDragButton.Position = UDim2.new(unpack(data.ZoneBtnPos)) end
end

local function CollectConfig()
    local data = {}
    for key in pairs(Defaults) do
        data[key] = _G[key]
    end
    data.CamBtnPos = {CamBtn.Position.X.Scale, CamBtn.Position.X.Offset, CamBtn.Position.Y.Scale, CamBtn.Position.Y.Offset}
    data.AimBtnPos = {AimBtn.Position.X.Scale, AimBtn.Position.X.Offset, AimBtn.Position.Y.Scale, AimBtn.Position.Y.Offset}
    data.JumpBtnPos = {JumpBtn.Position.X.Scale, JumpBtn.Position.X.Offset, JumpBtn.Position.Y.Scale, JumpBtn.Position.Y.Offset}
    data.V4BtnPos = {V4Btn.Position.X.Scale, V4Btn.Position.X.Offset, V4Btn.Position.Y.Scale, V4Btn.Position.Y.Offset}
    data.DashBtnPos = {DashBtn.Position.X.Scale, DashBtn.Position.X.Offset, DashBtn.Position.Y.Scale, DashBtn.Position.Y.Offset}
    data.ZoneBtnPos = {ZoneDragButton.Position.X.Scale, ZoneDragButton.Position.X.Offset, ZoneDragButton.Position.Y.Scale, ZoneDragButton.Position.Y.Offset}
    return data
end

local function SaveConfig()
    if typeof(writefile) ~= "function" then return end
    pcall(function()
        writefile(CONFIG_FILE, HttpService:JSONEncode(CollectConfig()))
    end)
end

local function LoadConfig()
    if typeof(isfile) ~= "function" or typeof(readfile) ~= "function" then return end
    local targetFile = nil
    if isfile(CONFIG_FILE) then
        targetFile = CONFIG_FILE
    elseif isfile(LEGACY_FILE) then
        targetFile = LEGACY_FILE
    end
    if not targetFile then return end

    local ok, decoded = pcall(function()
        return HttpService:JSONDecode(readfile(targetFile))
    end)
    if ok and type(decoded) == "table" then
        for key in pairs(Defaults) do
            if decoded[key] ~= nil then
                _G[key] = decoded[key]
            end
        end
        applySavedButtonPositions(decoded)
    end
end

