if typeof(hookmetamethod) == "function" and typeof(getnamecallmethod) == "function" then
    local old
    old = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        local target = getgenv().Capri and getgenv().Capri.CurrentTarget
        if not checkcaller() and (method == "FireServer" or method == "InvokeServer") and target and (_G.SilentAim_Player or _G.SilentAim_NPC) then
            local pred = target.Position + (target.Velocity * _G.PredictionStrength)
            for i, v in pairs(args) do
                if typeof(v) == "Vector3" then
                    args[i] = pred
                elseif typeof(v) == "CFrame" then
                    args[i] = CFrame.new(v.Position, pred)
                end
            end
        end
        return old(self, unpack(args))
    end)
end

local lastAuraTick = 0
local espDrawings = {}
