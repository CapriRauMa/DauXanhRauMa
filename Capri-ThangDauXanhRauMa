local function getBodyPart(char)
    return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
end

local function getTarget()
    local target, shortest = nil, getgenv().Capri.FOV
    local C = getgenv().Capri
    local center = Vector2.new(C.PosX, C.PosY)
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local bodyPart = getBodyPart(p.Character)
            local dist = (myRoot.Position - p.Character.HumanoidRootPart.Position).Magnitude
            
            if hum and hum.Health > 0 and bodyPart and dist <= C.MaxDist then
                local pos, onScreen = Camera:WorldToViewportPoint(bodyPart.Position)
                if onScreen then
                    local screenDist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if screenDist < shortest then
                        shortest = screenDist
                        target = p.Character
                    end
                end
            end
        end
    end
    return target
end

local lastAuraTick = 0
local espDrawings = {}

RunService.RenderStepped:Connect(function()
    local C = getgenv().Capri
    
    DragButton.Visible = C.UnlockFOV
    if not C.UnlockFOV and not draggingFOV then
        DragButton.Position = UDim2.new(0, C.PosX, 0, C.PosY)
    end

    FOVCircle.Visible = C.AB
    FOVCircle.Position = Vector2.new(C.PosX, C.PosY)

    -- Aimbot Logic
    if C.AB then
        local targetChar = getTarget()
        if targetChar then
            local bodyPart = getBodyPart(targetChar)
            if bodyPart then
                local bodyPos = bodyPart.Position
                local camPos = Camera.CFrame.Position
                local baseCFrame = CFrame.new(camPos, bodyPos)
                
                local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                local customCenter = Vector2.new(C.PosX, C.PosY)
                local offset = customCenter - screenCenter
                
                Camera.CFrame = baseCFrame * CFrame.Angles(math.rad(-offset.Y * 0.08), math.rad(-offset.X * 0.08), 0)
            end
        end
    end

    -- Hitbox Logic: Co giãn mượt mà từ Min (4) khi áp sát đến Max (40) khi ở xa
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                if C.HB then
                    local distToMe = myRoot and (myRoot.Position - hrp.Position).Magnitude or 999
                    
                    local minD, maxD = 4, 30
                    local alpha = math.clamp((distToMe - minD) / (maxD - minD), 0, 1)
                    local calculatedSize = C.MinHBSize + (C.MaxHBSize - C.MinHBSize) * alpha
                    
                    hrp.Size = Vector3.new(calculatedSize, calculatedSize, calculatedSize)
                    hrp.Transparency = 0.4
                    hrp.CanCollide = false
                else
                    hrp.Size = Vector3.new(2, 2, 1)
                    hrp.Transparency = 1
                    hrp.CanCollide = false
                end
            end
        end
    end

    -- Kill Aura Logic
    if C.KA then
        if tick() - lastAuraTick >= 2.0 then
            lastAuraTick = tick()
            pcall(function()
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if root then
                    local searchFolder = workspace:FindFirstChild("Enemies") or workspace
                    for _, obj in ipairs(searchFolder:GetDescendants()) do
                        if obj:IsA("Model") and obj ~= char then
                            local hum, hrp = obj:FindFirstChildOfClass("Humanoid"), obj:FindFirstChild("HumanoidRootPart")
                            if hum and hrp and hum.Health > 0 and (root.Position - hrp.Position).Magnitude <= 100 then
                                local isPlayer = Players:GetPlayerFromCharacter(obj) ~= nil
                                local isPlayer = Players:GetPlayerFromCharacter(obj) ~= nil
                                if not isPlayer then
                                    hum:TakeDamage(3387500)
                                else
                                    local pName = obj.Name
                                    if not C.PlayerTimers[pName] then
                                        C.PlayerTimers[pName] = tick()
                                    elseif tick() - C.PlayerTimers[pName] >= 1.0 then
                                        hum:TakeDamage(50)
                                        C.PlayerTimers[pName] = tick()
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end
    else
        C.PlayerTimers = {}
    end

    -- ESP Render Logic
    if C.ESP then
        local activeDrawings = {}

        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                local hrp = p.Character.HumanoidRootPart
                
                if hum and hum.Health > 0 then
                    local drawingObj = espDrawings[p]
                    if not drawingObj then
                        local box = Drawing.new("Square")
                        box.Color = Color3.fromRGB(0, 255, 128)
                        box.Thickness = 1.5
                        box.Filled = false
                        
                        local nameTag = Drawing.new("Text")
                        nameTag.Color = Color3.fromRGB(255, 255, 255)
                        nameTag.Size = 14
                        nameTag.Center = true
                        nameTag.Outline = true
                        
                        local line = Drawing.new("Line")
                        line.Color = Color3.fromRGB(0, 255, 128)
                        line.Thickness = 1
                        line.Transparency = 0.7
                        
                        drawingObj = {box = box, name = nameTag, line = line}
                        espDrawings[p] = drawingObj
                    end
                    
                    activeDrawings[p] = true
                    local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        local size = Vector2.new(2500 / pos.Z, 3500 / pos.Z)
                        drawingObj.box.Size = size
                        drawingObj.box.Position = Vector2.new(pos.X - size.X / 2, pos.Y - size.Y / 2)
                        drawingObj.box.Visible = true
                        
                        local distText = ""
                        if myRoot then
                            local distance = math.floor((myRoot.Position - hrp.Position).Magnitude)
                            distText = " [" .. distance .. "m]"
                        end

                        drawingObj.name.Text = p.Name .. " [" .. math.floor(hum.Health) + 0 .. " HP]" .. distText
                        drawingObj.name.Position = Vector2.new(pos.X, pos.Y - size.Y / 2 - 20)
                        drawingObj.name.Visible = true
                        
                        drawingObj.line.From = Vector2.new(C.PosX, C.PosY)
                        drawingObj.line.To = Vector2.new(pos.X, pos.Y)
                        drawingObj.line.Visible = true
                    else
                        drawingObj.box.Visible = false
                        drawingObj.name.Visible = false
                        drawingObj.line.Visible = false
                    end
                end
            end
        end

        for p, obj in pairs(espDrawings) do
            if not activeDrawings[p] then
                obj.box:Remove()
                obj.name:Remove()
                obj.line:Remove()
                espDrawings[p] = nil
            end
        end
    else
        for _, obj in pairs(espDrawings) do
            obj.box:Remove()
            obj.name:Remove()
            obj.line:Remove()
        end
        espDrawings = {}
    end
end)
