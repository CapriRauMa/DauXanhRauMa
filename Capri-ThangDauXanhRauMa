    tabBtn.Font = Enum.Font.SourceSansBold
    tabBtn.TextSize = 11
    Instance.new("UICorner", tabBtn).CornerRadius = UDim.new(0, 6)

    local page = Instance.new("ScrollingFrame", Container)
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.CanvasSize = UDim2.new(0, 0, 0, 250)
    page.ScrollBarThickness = 3
    page.Visible = false
    page.ZIndex = 1

    local grid = Instance.new("UIGridLayout", page)
    grid.CellSize = UDim2.new(0, 132, 0, 30)
    grid.CellPadding = UDim2.new(0, 6, 0, 6)

    Pages[tabName] = page
    TabButtons[tabName] = tabBtn

    tabBtn.MouseButton1Click:Connect(function()
        for name, p in pairs(Pages) do
            p.Visible = (name == tabName)
            TabButtons[name].BackgroundColor3 = (name == tabName) and Color3.fromRGB(0, 255, 128) or Color3.fromRGB(35, 35, 45)
            TabButtons[name].TextColor3 = (name == tabName) and Color3.fromRGB(20, 20, 25) or Color3.fromRGB(200, 200, 200)
        end
    end)

    return page
end

