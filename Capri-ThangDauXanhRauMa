local function createCircleBtn(name, text, posScale, textColor, textSize)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Parent = FloatGUI
    btn.Size = UDim2.new(0, 45, 0, 45)
    btn.Position = UDim2.new(unpack(posScale))
