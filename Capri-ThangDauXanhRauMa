local function createTabMenu(tabName)
    local tabBtn = Instance.new("TextButton", TabHolder)
    tabBtn.Size = UDim2.new(1, -10, 0, 28)
    tabBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    tabBtn.Text = tabName
